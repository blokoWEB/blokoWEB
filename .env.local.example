# Supabase — cria um projeto gratuito em https://supabase.com
# Depois: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin do painel — gera com: node scripts/hash-password.mjs "a-tua-password"
# (o valor vem em base64 de propósito — evita que o Next.js interprete
# "$2b"/"$10" do hash bcrypt como variáveis de ambiente)
ADMIN_USERNAME=blokoadmin
ADMIN_PASSWORD_HASH_B64=JDJhJDEwJC4uLg==

# Qualquer string aleatória longa (ex: gerada com `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=troca-isto-por-uma-string-aleatoria-longa

# Domínio de produção do site (usado em SEO: metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://bloko.com.pt

# IMPORTANTE: deixa isto por definir (ou "false") em qualquer ambiente que
# não seja o domínio final — bloqueia a indexação no Google por segurança
# (ex: no URL de preview da Vercel, antes de ligarmos bloko.com.pt).
# Só definir como "true" na Vercel quando o site estiver mesmo em produção.
NEXT_PUBLIC_ENABLE_INDEXING=false

# SMTP — envio de emails do site (ex: inscrições da Academia), via a conta
# de email do alojamento do domínio (cPanel > Email Accounts).
SMTP_HOST=mail.bloko.com.pt
SMTP_PORT=587
SMTP_USER=geral@bloko.com.pt
SMTP_PASS=a-password-da-conta-de-email
# Opcional — para onde os emails são enviados, se for diferente de SMTP_USER
SMTP_TO=geral@bloko.com.pt
